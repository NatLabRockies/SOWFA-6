temperatureSource
{
    type        "given";

    //Relaxation factor (only used when type is "computed")
    gain        0.7;

    sourceHeightsTemperature
    (
        $windControlHeight
    );
    
    sourceTableTemperature
    (
        //#include "drivingData/forcingTable"
	      (    0.0 0.0)
        (90000.0 0.0)
    );
}

