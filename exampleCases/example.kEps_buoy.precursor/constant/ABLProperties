//}
momentumSource
{
    type        "computed";
    inputType   "component"; //"speedAndDirection";

    //Relaxation factor (only used when type is "computed")
    gain        0.2;

    sourceHeightsMomentum
    (
        $windControlHeight
    );
    
    sourceTableMomentumX
    (
        (    0.0 0.0)
        (90000.0 0.0)
    );
    
    sourceTableMomentumY
    (
        (    0.0 -9.8)
        (90000.0 -9.8)
    );
    
    sourceTableMomentumZ
    (
        (    0.0 0.0)
        (90000.0 0.0)
    );
}

