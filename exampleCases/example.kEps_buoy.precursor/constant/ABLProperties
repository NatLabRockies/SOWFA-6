//#include        "../setUp"
#include	"physicalProperties"

advectionDamping
{
    active  false;

    advDampingLayers
    (
       {
        origin (0 30000 0);
        normal (0 1 0);

        offset 3000;

        deltaStart 1000;

        buffer 2000;

        deltaEnd 1000;
        }
    );

    zi       750.0;
    filterH  200.0;
}


