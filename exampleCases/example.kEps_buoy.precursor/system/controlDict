FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     superDeliciousVanilla;

libs            ( "libSOWFAboundaryConditions.so" "libSOWFAincompressibleTurbulenceModels.so" );

//nCores		128;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         20000;

deltaT          0.5;

writeControl    adjustableRunTime;

writeInterval   500;

purgeWrite      1;

writeFormat     binary;

writePrecision  12;

writeCompression uncompressed;

timeFormat      general;

timePrecision   12;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.85;

maxDeltaT       1;

functions
{
//#include "sampling/boundaryData"
#include "sampling/slicesPrecursor"
#include "schemeBlending"
#include "sampling/planarAveraging"
}


