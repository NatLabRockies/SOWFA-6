FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    note        "mesh decomposition control dictionary";
    location    "system";
    object      decomposeParDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//#include        "../constant/physicalProperties"


numberOfSubdomains  128; //$nCores;
method          scotch; //$decompType;
preservePatches (north south east west);

simpleCoeffs
{
    n           (8 1 16); //$decompOrder;
    delta       0.001;
}

hierarchicalCoeffs
{
    n           (1 1 3);
    delta       0.001;
    order       xyz;
}

metisCoeffs
{
}

scotchCoeffs
{
}

manualCoeffs
{
    dataFile    "decompositionData";
}


//// Is the case distributed
distributed     no;
